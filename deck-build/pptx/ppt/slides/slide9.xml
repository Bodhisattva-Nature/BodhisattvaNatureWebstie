0" sz="2100" u="none" cap="none" strike="noStrike"><a:solidFill><a:srgbClr val="778749"/></a:solidFill><a:latin typeface="Short Stack"/><a:ea typeface="Short Stack"/><a:cs typeface="Short Stack"/><a:sym typeface="Short Stack"/></a:rPr><a:t>Top Retreat - Journey to Mindfulness</a:t></a:r><a:endParaRPr sz="1100"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="425" name="Google Shape;425;p31"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="1168680" y="1256420"/><a:ext cx="6806640" cy="3507106"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></p:spPr><p:txBody><a:bodyPr anchorCtr="0" anchor="t" bIns="34275" lIns="34275" spcFirstLastPara="1" rIns="34275" wrap="square" tIns="34275"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" lvl="0" marL="0" marR="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:srgbClr val="778749"/></a:buClr><a:buSzPts val="1600"/><a:buFont typeface="Times"/><a:buNone/></a:pPr><a:r><a:rPr b="0" i="0" lang="en-CA" spc="0" sz="1600" u="none" cap="none" strike="noStrike"><a:solidFill><a:srgbClr val="778749"/></a:solidFill><a:latin typeface="Times"/><a:ea typeface="Times"/><a:cs typeface="Times"/><a:sym typeface="Times"/></a:rPr><a:t>The </a:t></a:r><a:r><a:rPr b="1" i="0" lang="en-CA" spc="0" sz="1600" u="none" cap="none" strike="noStrike"><a:solidFill><a:srgbClr val="778749"/></a:solidFill><a:latin typeface="Times"/><a:ea typeface="Times"/><a:cs typeface="Times"/><a:sym typeface="Times"/></a:rPr><a:t>Journey to Mindfulness</a:t></a:r><a:r><a:rPr b="0" i="0" lang="en-CA" spc="0" sz="1600" u="none" cap="none" strike="noStrike"><a:solidFill><a:srgbClr val="778749"/></a:solidFill><a:latin typeface="Times"/><a:ea typeface="Times"/><a:cs typeface="Times"/><a:sym typeface="Times"/></a:rPr><a:t> is a four-day, wellness retreat that integrates ancient Eastern wisdom from Taoism, Confucianism, and Buddhism with practical mindfulness techniques to reduce stress and anxiety, enhance emotional well-being, cultivate positive energy, and foster compassion and altruism.</a:t></a:r><a:endParaRPr sz="1100"/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" marR="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="900"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:srgbClr val="778749"/></a:buClr><a:buSzPts val="1600"/><a:buFont typeface="Times"/><a:buNone/></a:pPr><a:r><a:rPr b="0" i="0" lang="en-CA" spc="0" sz="1600" u="none" cap="none" strike="noStrike"><a:solidFill><a:srgbClr val="778749"/></a:solidFill><a:latin typeface="Times"/><a:ea typeface="Times"/><a:cs typeface="Times"/><a:sym typeface="Times"/></a:rPr><a:t>Through guided meditation, self-reflection, and group discussions, participants develop greater self-awareness, emotional resilience, and inner peace.</a:t></a:r><a:endParaRPr sz="1100"/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" marR="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="900"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:srgbClr val="778749"/></a:buClr><a:buSzPts val="1600"/><a:buFont typeface="Times"/><a:buNone/></a:pPr><a:r><a:rPr b="1" i="0" lang="en-CA" spc="0" sz="1600" u="none" cap="none" strike="noStrike"><a:solidFill><a:srgbClr val="778749"/></a:solidFill><a:latin typeface="Times"/><a:ea typeface="Times"/><a:cs typeface="Times"/><a:sym typeface="Times"/></a:rPr><a:t>Open to everyone regardless of religious beliefs or background</a:t></a:r><a:r><a:rPr b="0" i="0" lang="en-CA" spc="0" sz="1600" u="none" cap="none" strike="noStrike"><a:solidFill><a:srgbClr val="778749"/></a:solidFill><a:latin typeface="Times"/><a:ea typeface="Times"/><a:cs typeface="Times"/><a:sym typeface="Times"/></a:rPr><a:t>, the retreat requires no prior experience and encourages full participation throughout the four-day program.</a:t></a:r><a:endParaRPr sz="1100"/></a:p><a:p><a:pPr indent="0" lvl="0" marL="0" marR="0" rtl="0" algn="l"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="900"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClr><a:srgbClr val="778749"/></a:buClr><a:buSzPts val="1600"/><a:buFont typeface="Times"/><a:buNone/></a:pPr><a:r><a:rPr b="1" i="0" lang="en-CA" spc="0" sz="1600" u="none" cap="none" strike="noStrike"><a:solidFill><a:srgbClr val="778749"/></a:solidFill><a:latin typeface="Times"/><a:ea typeface="Times"/><a:cs typeface="Times"/><a:sym typeface="Times"/></a:rPr><a:t>This is a nonprofit, public-benefit program.</a:t></a:r><a:r><a:rPr b="0" i="0" lang="en-CA" spc="0" sz="1600" u="none" cap="none" strike="noStrike"><a:solidFill><a:srgbClr val="778749"/></a:solidFill><a:latin typeface="Times"/><a:ea typeface="Times"/><a:cs typeface="Times"/><a:sym typeface="Times"/></a:rPr><a:t> All instruction and activities are provided free of charge; participants pay only for accommodation and meals. The program aims to enhance individual well-being and build healthier, more compassionate communities.</a:t></a:r><a:endParaRPr sz="1100"/></a:p></p:txBody></p:sp><p:pic><p:nvPicPr><p:cNvPr descr="logo - U.S. rec black.png" id="426" name="Google Shape;426;p31"/><p:cNvPicPr preferRelativeResize="0"/><p:nvPr/></p:nvPicPr><p:blipFill rotWithShape="1"><a:blip r:embed="rId3"><a:alphaModFix/></a:blip><a:srcRect b="0" l="0" r="0" t="0"/><a:stretch/></p:blipFill><p:spPr><a:xfrm><a:off x="7803146" y="331987"/><a:ext cx="911558" cy="512752"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></p:spPr></p:pic></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>