---
import global from "../styles/global.css?url";
import fontCssRaw from "../fonts.css?raw";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getContent, type Lang } from "../i18n";
import { oppositeHref } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: Lang;
  zhOnly?: boolean;
}

const lang: Lang = Astro.props.lang ?? "en";
const zhOnly = Astro.props.zhOnly ?? false;
const { t } = getContent(lang);
const { title, description = t.site.description, image } = Astro.props;
const alternate = oppositeHref(Astro.url.pathname, lang);
const SITE = Astro.site ?? new URL("https://example.com");
// /404/ is not a page that exists; point the error page at its language home
const is404 = /\/404\/?$/.test(Astro.url.pathname);
const canonical = new URL(is404 ? (lang === "zh" ? "/zh/" : "/") : Astro.url.pathname, SITE).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// every page needs a share image; fall back to the hero
const ogImage = new URL(`${base}/media/${image ?? "hero"}-1600.webp`, SITE).href;
const fontCss = fontCssRaw.replaceAll("url('/fonts/", `url('${base}/fonts/`);
---

<!doctype html>
<html lang={lang === "zh" ? "zh-Hans" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {zhOnly ? (
      <>
        <link rel="alternate" hreflang="zh-Hans" href={canonical} />
        <link rel="alternate" hreflang="x-default" href={canonical} />
      </>
    ) : (
      <>
        <link rel="alternate" hreflang={lang === "zh" ? "en" : "zh-Hans"} href={new URL(alternate, Astro.site ?? "https://example.com").href} />
        <link rel="alternate" hreflang={lang === "zh" ? "zh-Hans" : "en"} href={canonical} />
        <link rel="alternate" hreflang="x-default" href={lang === "zh" ? new URL(alternate, Astro.site ?? "https://example.com").href : canonical} />
      </>
    )}
    <meta name="theme-color" content="#f5f0e6" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}/icon-192.png`} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preload" href={`${base}/fonts/fraunces-normal-300_700-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/inter-normal-300_700-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={global} />
    <style is:inline set:html={fontCss}></style>
  </head>
  <body>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
    <script>
      const header = document.querySelector(".header") as HTMLElement | null;

      function syncHeader() {
        if (!header) return;
        header.classList.toggle("is-solid", window.scrollY > 16);
      }
      syncHeader();
      window.addEventListener("scroll", syncHeader, { passive: true });

      // reveal on scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.06 }
      );
      function observe() {
        document.querySelectorAll("[data-reveal]:not(.is-in)").forEach((el) => io.observe(el));
      }
      observe();
      document.addEventListener("astro:page-load", () => {
        observe();
        syncHeader();
      });

      // mobile drawer
      const burger = document.querySelector(".burger") as HTMLButtonElement | null;
      const drawer = document.querySelector(".drawer") as HTMLElement | null;
      burger?.addEventListener("click", () => {
        const open = burger.getAttribute("aria-expanded") === "true";
        burger.setAttribute("aria-expanded", String(!open));
        drawer?.setAttribute("data-open", String(!open));
        document.body.style.overflow = open ? "" : "hidden";
        // the drawer is paper-coloured, so the header must flip back to ink while it is open
        if (!open) {
          header?.classList.add("is-solid", "is-menu-open");
          drawer?.scrollTo({ top: 0 });
        } else {
          header?.classList.remove("is-menu-open");
          syncHeader();
        }
      });
      drawer?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          burger?.setAttribute("aria-expanded", "false");
          drawer.setAttribute("data-open", "false");
          document.body.style.overflow = "";
          header?.classList.remove("is-menu-open");
          syncHeader();
        })
      );

      // desktop header dropdowns
      const drops = Array.from(document.querySelectorAll<HTMLElement>(".nav__drop"));
      const setDrop = (drop: HTMLElement, open: boolean) => {
        drop.querySelector<HTMLButtonElement>(".nav__drop-toggle")?.setAttribute("aria-expanded", String(open));
        drop.setAttribute("data-open", String(open));
      };
      for (const drop of drops) {
        const toggle = drop.querySelector<HTMLButtonElement>(".nav__drop-toggle");
        toggle?.addEventListener("click", () => {
          setDrop(drop, toggle.getAttribute("aria-expanded") !== "true");
        });
        if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
          drop.addEventListener("mouseenter", () => setDrop(drop, true));
          drop.addEventListener("mouseleave", () => setDrop(drop, false));
        }
        drop.addEventListener("focusout", (event) => {
          if (!drop.contains(event.relatedTarget as Node)) setDrop(drop, false);
        });
      }
      document.addEventListener("click", (event) => {
        for (const drop of drops) {
          if (!drop.contains(event.target as Node)) setDrop(drop, false);
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        for (const drop of drops) {
          const inside = drop.contains(document.activeElement);
          setDrop(drop, false);
          if (inside) drop.querySelector<HTMLButtonElement>(".nav__drop-toggle")?.focus();
        }
      });
    </script>
  </body>
</html>
