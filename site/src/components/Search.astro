---
import { getContent, type Lang } from "../i18n";
interface Props { lang?: Lang }
const lang: Lang = Astro.props.lang ?? "en";
const { t } = getContent(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const indexHref = lang === "zh" ? `${base}/zh/search-index.json` : `${base}/search-index.json`;
---

<div class="search" data-search data-index={indexHref} data-empty={t.search.empty}>
  <button class="search__trigger" type="button" aria-label="Search the site" data-search-open>
    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
      <circle cx="7" cy="7" r="4.6" /><path d="m10.6 10.6 3 3" />
    </svg>
    <span>{t.search.button}</span>
    <kbd>⌘K</kbd>
  </button>

  <div class="search__overlay" data-search-overlay hidden>
    <div class="search__panel" role="dialog" aria-modal="true" aria-label="Search">
      <div class="search__field">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="7" cy="7" r="4.6" /><path d="m10.6 10.6 3 3" />
        </svg>
        <input type="search" placeholder={t.search.placeholder} autocomplete="off" spellcheck="false" data-search-input />
        <button type="button" class="search__close" data-search-close aria-label="Close">Esc</button>
      </div>
      <ul class="search__results" data-search-results></ul>
      <div class="search__hint">
        <span><kbd>↑</kbd><kbd>↓</kbd> {t.search.navigate}</span>
        <span><kbd>↵</kbd> {t.search.open}</span>
      </div>
    </div>
  </div>
</div>



<script>
  const root = document.querySelector("[data-search]") as HTMLElement | null;
  if (root) {
    const overlay = root.querySelector("[data-search-overlay]") as HTMLElement;
    const input = root.querySelector("[data-search-input]") as HTMLInputElement;
    const list = root.querySelector("[data-search-results]") as HTMLElement;
    const openBtn = root.querySelector("[data-search-open]") as HTMLButtonElement;
    const closeBtn = root.querySelector("[data-search-close]") as HTMLButtonElement;
    const indexUrl = root.dataset.index as string;
    const emptyMsg = (root.dataset.empty as string) || "No results";
    let docs: any[] | null = null;
    let active = 0;

    async function load() {
      if (docs) return docs;
      const res = await fetch(indexUrl);
      docs = (await res.json()).docs;
      return docs;
    }

    function render(q: string) {
      const query = q.trim().toLowerCase();
      const items = (docs ?? []).filter((d) => !query || (d.t + " " + d.d + " " + d.k).toLowerCase().includes(query)).slice(0, 8);
      active = 0;
      if (!items.length) {
        list.innerHTML = `<li class="search__empty">${emptyMsg.replace(/</g, "&lt;")}</li>`;
        return;
      }
      list.innerHTML = items
        .map((d, i) => `<li><a href="${d.u}" data-i="${i}" aria-selected="${i === 0}"><span class="kind">${d.k}</span><span><span class="title">${d.t}</span><span class="desc">${d.d}</span></span></a></li>`)
        .join("");
    }

    function open() {
      overlay.hidden = false;
      document.body.style.overflow = "hidden";
      input.value = "";
      load().then(() => render(""));
      setTimeout(() => input.focus(), 30);
    }

    function close() {
      overlay.hidden = true;
      document.body.style.overflow = "";
    }

    function move(dir: number) {
      const links = Array.from(list.querySelectorAll("a")) as HTMLAnchorElement[];
      if (!links.length) return;
      active = (active + dir + links.length) % links.length;
      links.forEach((l, i) => l.setAttribute("aria-selected", String(i === active)));
      links[active].scrollIntoView({ block: "nearest" });
    }

    openBtn.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });
    input.addEventListener("input", () => render(input.value));

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        overlay.hidden ? open() : close();
      } else if (e.key === "Escape" && !overlay.hidden) {
        close();
      } else if (!overlay.hidden) {
        if (e.key === "ArrowDown") { e.preventDefault(); move(1); }
        if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
        if (e.key === "Enter") {
          const link = list.querySelector(`a[data-i="${active}"]`) as HTMLAnchorElement | null;
          if (link) window.location.href = link.href;
        }
      }
    });
  }
</script>
