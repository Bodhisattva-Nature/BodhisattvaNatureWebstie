---
import PrayerFlags from "./PrayerFlags.astro";
import { getContent, contact, type Lang } from "../i18n";
import { href, oppositeHref } from "../lib/url";
import Search from "./Search.astro";
import Img from "./Img.astro";

interface Props { lang?: Lang }
const lang: Lang = Astro.props.lang ?? "en";
const { t, isZh } = getContent(lang);

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const isActive = (h: string) =>
  isZh ? path === "/zh" + h || path.startsWith("/zh" + h) : (h === "/" ? path === "/" : path.startsWith(h));
const other = oppositeHref(Astro.url.pathname, lang);
---

<header class="header">
  <PrayerFlags />
  <div class="wrap header__inner">
    <a href={href("/", lang)} class="brand" aria-label={t.site.name}>
      <Img name="logo" alt={t.site.name} class="brand__logo" sizes="180px" loading="eager" />
    </a>

    <nav class="nav" aria-label="Primary">
      {t.nav.map((item) => (
        <a href={href(item.href, lang)} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>

    {isZh && (
      <a class="header__ext" href={t.external.activities.href} target="_blank" rel="noopener">
        {t.external.activities.label}
        <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M5 11 11 5M6 5h5v5" />
        </svg>
      </a>
    )}

    <a class="lang-toggle" href={other} hreflang={isZh ? "en" : "zh-Hans"} aria-label={isZh ? "Switch to English" : "切换到中文"}>
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
        <circle cx="8" cy="8" r="6.4" />
        <path d="M1.6 8h12.8M8 1.6c1.9 1.8 2.9 4 2.9 6.4S9.9 12.6 8 14.4C6.1 12.6 5.1 10.4 5.1 8S6.1 3.4 8 1.6z" />
      </svg>
      <span>{t.other}</span>
    </a>

    <Search lang={lang} />

    <div class="header__cta">
      <a href={href("/donate/", lang)} class="btn">{t.cta.donate}</a>
    </div>

    <button class="burger" aria-label="Menu" aria-expanded="false" aria-controls="drawer">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="drawer" id="drawer" data-open="false">
  <nav aria-label="Mobile">
    <a href={href("/", lang)}>
      {t.navHome}
      <span>00</span>
    </a>
    {t.nav.map((item, i) => (
      <a href={href(item.href, lang)}>
        {item.label}
        <span>0{i + 1}</span>
      </a>
    ))}
    <a href={href("/donate/", lang)}>
      {t.cta.donate}
      <span>07</span>
    </a>
    {isZh && (
      <a href={t.external.activities.href} target="_blank" rel="noopener">
        {t.external.activities.label}
        <span>↗</span>
      </a>
    )}
  </nav>
  <div class="drawer__foot">
    <p><strong>{contact.email}</strong></p>
    <p>{contact.phone}</p>
  </div>
</div>
