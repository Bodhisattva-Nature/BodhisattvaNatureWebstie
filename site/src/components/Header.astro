---
import { nav, site } from "../data/site";
import { url } from "../lib/url";
import Search from "./Search.astro";

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="header">
  <span class="flagline" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
  <div class="wrap header__inner">
    <a href={url("/")} class="brand" aria-label={`${site.name} — home`}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="24" cy="24" r="20.5" />
          <circle cx="24" cy="24" r="4.6" />
          <g stroke-linecap="round">
            <path d="M24 3.5v16" /><path d="M24 28.5v16" />
            <path d="M3.5 24h16" /><path d="M28.5 24h16" />
            <path d="M9.5 9.5l11.3 11.3" /><path d="M27.2 27.2l11.3 11.3" />
            <path d="M38.5 9.5L27.2 20.8" /><path d="M20.8 27.2L9.5 38.5" />
          </g>
        </svg>
      </span>
      <span class="brand__text">
        Bodhisattva Nature
        <small>Foundation</small>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={url(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>

    <Search />

    <div class="header__cta">
      <a href={url("/donate/")} class="btn">Donate</a>
    </div>

    <button class="burger" aria-label="Menu" aria-expanded="false" aria-controls="drawer">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="drawer" id="drawer" data-open="false">
  <nav aria-label="Mobile">
    {nav.map((item, i) => (
      <a href={url(item.href)}>
        {item.label}
        <span>0{i + 1}</span>
      </a>
    ))}
    <a href={url("/donate/")}>
      Donate
      <span>06</span>
    </a>
  </nav>
  <div class="drawer__foot">
    <p><strong>{site.email}</strong></p>
    <p>{site.phone} · Vancouver · Calgary · Toronto</p>
  </div>
</div>
