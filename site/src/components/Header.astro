---
import PrayerFlags from "./PrayerFlags.astro";
import { getContent, contact, type Lang } from "../i18n";
import { href, oppositeHref } from "../lib/url";
import Search from "./Search.astro";
import Img from "./Img.astro";

interface Props { lang?: Lang }
const lang: Lang = Astro.props.lang ?? "en";
const { t, isZh, programs } = getContent(lang);

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const isActive = (h: string) =>
  isZh ? path === "/zh" + h || path.startsWith("/zh" + h) : (h === "/" ? path === "/" : path.startsWith(h));
const other = oppositeHref(Astro.url.pathname, lang);
const community = t.nav.find((item) => item.href === "/community/");
const programsActive = isActive("/programs/") || isActive("/community/");
const joinActive = isActive("/contact/") || isActive("/volunteer/");
---

<header class="header">
  <PrayerFlags />
  <div class="wrap header__inner">
    <a href={href("/", lang)} class="brand" aria-label={t.site.name}>
      <Img name="logo" alt={t.site.name} class="brand__logo" sizes="180px" loading="eager" />
    </a>

    <nav class="nav" aria-label="Primary">
      {t.nav.map((item) => {
        if (item.href === "/community/" || item.href === "/volunteer/") return null;
        if (item.href === "/programs/") {
          return (
            <div class="nav__drop">
              <button
                type="button"
                class="nav__drop-toggle"
                aria-expanded="false"
                aria-controls="programs-menu"
                data-active={programsActive ? "" : undefined}
              >
                {item.label}
                <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="m4 6 4 4 4-4" />
                </svg>
              </button>
              <div class="nav__menu" id="programs-menu">
                <a class="nav__menu-all" href={href("/programs/", lang)}>{t.programDetail.allPrograms}</a>
                {programs.map((program) => (
                  <a
                    href={href(`/programs/${program.slug}/`, lang)}
                    aria-current={isActive(`/programs/${program.slug}/`) ? "page" : undefined}
                  >
                    {program.title}
                  </a>
                ))}
                {community && (
                  <a
                    class="nav__menu-community"
                    href={href(community.href, lang)}
                    aria-current={isActive(community.href) ? "page" : undefined}
                  >
                    {community.label}
                  </a>
                )}
              </div>
            </div>
          );
        }
        if (item.href === "/contact/") {
          return (
            <div class="nav__drop">
              <button
                type="button"
                class="nav__drop-toggle"
                aria-expanded="false"
                aria-controls="join-menu"
                data-active={joinActive ? "" : undefined}
              >
                {item.label}
                <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="m4 6 4 4 4-4" />
                </svg>
              </button>
              <div class="nav__menu" id="join-menu">
                <a class="nav__menu-all" href={href("/contact/", lang)}>{t.cta.contact}</a>
                <a
                  href={href("/volunteer/", lang)}
                  aria-current={isActive("/volunteer/") ? "page" : undefined}
                >
                  {t.cta.volunteer}
                </a>
              </div>
            </div>
          );
        }
        return <a href={href(item.href, lang)} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>;
      })}
      <a class="nav__external" href={t.external.activities.href} target="_blank" rel="noopener">{t.external.activities.headerLabel}</a>
    </nav>

    <div class="zh-menu" role="group" aria-label={isZh ? "语言与中文网站" : "Language and Chinese website"}>
      <a class="zh-menu__item" href={other} hreflang={isZh ? "en" : "zh-Hans"} aria-label={isZh ? "Switch to English" : "切换到中文"}>
        {t.other}
      </a>
      <a class="zh-menu__item" href={t.external.website.href} target="_blank" rel="noopener">
        {t.external.website.label}
        <span class="zh-menu__arrow" aria-hidden="true">↗</span>
      </a>
    </div>

    <Search lang={lang} />

    <div class="header__cta">
      <a href={href("/donate/", lang)} class="btn">{t.cta.donate}</a>
    </div>

    <button class="burger" aria-label="Menu" aria-expanded="false" aria-controls="drawer">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="drawer" id="drawer" data-open="false">
  <nav aria-label="Mobile">
    <a href={href("/", lang)}>
      {t.navHome}
      <span>00</span>
    </a>
    {t.nav.map((item, i) => {
      if (item.href === "/community/" || item.href === "/volunteer/") return null;
      if (item.href === "/programs/") {
        return (
          <details class="drawer__group" open={programsActive}>
            <summary>
              {item.label}
              <span>0{i + 1}</span>
            </summary>
            <div class="drawer__sub">
              <a href={href("/programs/", lang)}>{t.programDetail.allPrograms}</a>
              {programs.map((program) => (
                <a href={href(`/programs/${program.slug}/`, lang)}>{program.title}</a>
              ))}
              {community && <a href={href(community.href, lang)}>{community.label}</a>}
            </div>
          </details>
        );
      }
      if (item.href === "/contact/") {
        return (
          <details class="drawer__group" open={joinActive}>
            <summary>
              {item.label}
              <span>0{i + 1}</span>
            </summary>
            <div class="drawer__sub">
              <a href={href("/contact/", lang)}>{t.cta.contact}</a>
              <a href={href("/volunteer/", lang)}>{t.cta.volunteer}</a>
            </div>
          </details>
        );
      }
      return (
        <a href={href(item.href, lang)}>
          {item.label}
          <span>0{i + 1}</span>
        </a>
      );
    })}
    <a href={href("/donate/", lang)}>
      {t.cta.donate}
      <span>08</span>
    </a>
    <a href={t.external.activities.href} target="_blank" rel="noopener">
      {t.external.activities.label}
      <span>↗</span>
    </a>
  </nav>
  <div class="drawer__foot">
    <p><strong>{contact.email}</strong></p>
    <p>{contact.phone}</p>
  </div>
</div>
