---
import Img from "./Img.astro";
import Lotus from "./Lotus.astro";
import { href } from "../lib/url";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
  event: {
    title: string;
    titleCn?: string;
    cadence?: string;
    time?: string;
    place?: string;
    image?: string;
  };
  index?: number;
  tba: string;
}

const { lang, event, index = 0, tba } = Astro.props;
const facts = [event.time, event.place].filter(Boolean).join(" · ");
---

<a class="event-card" href={href("/events/", lang)} data-reveal style={`--i:${index}`}>
  {event.image ? (
    <div class="media zoom" style="aspect-ratio:16/10">
      <Img name={event.image} alt={event.title} sizes="(max-width: 860px) 100vw, 46vw" />
    </div>
  ) : (
    <div class="media event-card__blank" style="aspect-ratio:16/10">
      <Lotus />
    </div>
  )}
  <div class="event-card__body">
    {event.cadence && <span class="pillar__sub">{event.cadence}</span>}
    <h3>{event.title}{event.titleCn && <span> · {event.titleCn}</span>}</h3>
    {facts ? <p>{facts}</p> : <p>{tba}</p>}
  </div>
</a>
