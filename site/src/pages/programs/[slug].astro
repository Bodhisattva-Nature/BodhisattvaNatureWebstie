---
import Base from "../../layouts/Base.astro";
import Img from "../../components/Img.astro";
import { programs, site } from "../../data/site";
import { url } from "../../lib/url";

export function getStaticPaths() {
  return programs.map((p) => ({ params: { slug: p.slug }, props: { program: p } }));
}

const { program } = Astro.props;
const others = programs.filter((p) => p.slug !== program.slug).slice(0, 3);
---

<Base title={`${program.title} — ${site.name}`} description={program.summary} image={program.image}>
  <header class="prog-head">
    <div class="wrap prog-head__inner">
      <div>
        <span class="eyebrow" data-reveal>{program.kicker} · {program.no}</span>
        <h1 data-reveal style="--i:1">{program.title}</h1>
        <p class="lede" data-reveal style="--i:2">{program.summary}</p>
      </div>
      <div class="prog-head__media media media--tile" data-reveal style="--i:2">
        <Img name={program.image} alt={program.title} sizes="(max-width: 900px) 100vw, 42vw" loading="eager" />
      </div>
    </div>
  </header>

  <section class="section" style="padding-top:clamp(2.5rem,5vw,4rem)">
    <div class="wrap split">
      <div class="split__body">
        <span class="eyebrow" data-reveal>Overview</span>
        {program.intro.map((p, i) => (
          <p class="lede" data-reveal style={`--i:${i}`}>{p}</p>
        ))}
        {program.links && (
          <div class="link-list" data-reveal style="--i:3">
            {program.links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener" class="link-row">
                <span>{l.label}</span>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3">
                  <path d="M4 12 12 4M6 4h6v6" />
                </svg>
              </a>
            ))}
          </div>
        )}
      </div>
      <aside class="side-note" data-reveal style="--i:2">
        <p class="caption">At a glance</p>
        <dl>
          <div><dt>Format</dt><dd>Online and in person</dd></div>
          <div><dt>Cost</dt><dd>Free</dd></div>
          <div><dt>Where</dt><dd>Vancouver · Calgary · Toronto · online</dd></div>
        </dl>
        <a class="btn" href={url("/contact/")} style="margin-top:1.5rem">{program.cta}</a>
      </aside>
    </div>
  </section>

  {program.truths && (
    <section class="section section--cream">
      <div class="wrap">
        <span class="eyebrow" data-reveal>The four noble truths</span>
        <div class="truths">
          {program.truths.map((t, i) => (
            <article class="truth" data-reveal style={`--i:${i}`}>
              <span class="truth__no">0{i + 1}</span>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow" data-reveal>What it covers</span>
          <h2 class="h2" data-reveal style="--i:1">In this programme.</h2>
        </div>
      </div>
      <div class="highlights">
        {program.highlights.map((h, i) => (
          <article class="highlight" data-reveal style={`--i:${i}`}>
            <h3>{h.title}</h3>
            <p>{h.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow" data-reveal>Keep going</span>
          <h2 class="h2" data-reveal style="--i:1">Other ways in.</h2>
        </div>
        <a class="link-arrow" href={url("/programs/")} data-reveal>All programs</a>
      </div>
      <div class="others">
        {others.map((p, i) => (
          <a class="other" href={url(`/programs/${p.slug}/`)} data-reveal style={`--i:${i}`}>
            <div class="other__media media media--tile zoom">
              <Img name={p.image} alt={p.title} sizes="(max-width: 800px) 100vw, 30vw" />
            </div>
            <span class="other__no">{p.no}</span>
            <h3>{p.title}</h3>
            <span class="link-arrow">
              Explore
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .prog-head {
    padding-top: calc(84px + clamp(2.5rem, 6vw, 5rem));
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .prog-head__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }

  .prog-head h1 {
    font-size: clamp(2.4rem, 6.5vw, 5.2rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.038em;
    margin-block: 0.35em 0;
  }

  .prog-head .lede { margin-top: 1.4rem; }

  .prog-head__media { aspect-ratio: 5/4; }

  .link-list {
    display: grid;
    border-top: 1px solid var(--line);
    margin-top: 0.5rem;
  }

  .link-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
    transition: color 0.3s var(--ease), padding 0.4s var(--ease);
  }

  .link-row:hover { color: var(--saffron); padding-left: 0.4rem; }

  .side-note {
    align-self: start;
    border: 1px solid var(--line);
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--cream);
    display: grid;
    gap: 1rem;
    position: sticky;
    top: 110px;
  }

  .side-note dl { margin: 0; display: grid; gap: 0.9rem; }
  .side-note div { display: grid; gap: 0.15rem; }
  .side-note dt { font-size: 0.64rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .side-note dd { margin: 0; font-size: 0.95rem; }

  .truths {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin-top: 2.5rem;
  }

  .truth {
    border-top: 1px solid var(--line);
    padding-top: 1.3rem;
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .truth__no { font-size: 0.68rem; letter-spacing: 0.16em; color: var(--saffron); }
  .truth h3 { font-size: var(--step-2); font-weight: 300; }
  .truth p { color: var(--muted); margin: 0; font-size: 0.95rem; }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .section-head .h2 { margin-top: 0.5rem; }

  .highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .highlight {
    border-top: 1px solid var(--line);
    padding-top: 1.3rem;
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .highlight h3 { font-size: var(--step-1); font-family: var(--font-body); font-weight: 500; letter-spacing: -0.01em; }
  .highlight p { color: var(--muted); margin: 0; font-size: 0.94rem; }

  .others {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .other { display: grid; gap: 0.9rem; align-content: start; }
  .other__media { aspect-ratio: 4/3; }
  .other__no { font-size: 0.64rem; letter-spacing: 0.18em; color: rgba(236, 230, 216, 0.45); }
  .other h3 { font-size: var(--step-2); font-weight: 300; }
  .section--ink .link-arrow { border-color: rgba(236, 230, 216, 0.3); color: rgba(236, 230, 216, 0.85); }

  @media (max-width: 900px) {
    .prog-head__inner { grid-template-columns: 1fr; }
    .prog-head__media { aspect-ratio: 16/10; }
    .truths, .highlights, .others { grid-template-columns: 1fr; }
    .side-note { position: static; }
  }
</style>
