---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import { getContent, type Lang } from "../i18n";
import { href } from "../lib/url";

interface Props { lang?: Lang }
const lang: Lang = Astro.props.lang ?? "en";
const { t, schedule, retreat, testimonials } = getContent(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base lang={lang} title={`${t.community.title} — ${t.site.name}`} description={t.community.lede}>
  <header class="page-head">
    <div class="wrap">
      <span class="eyebrow" data-reveal>{t.community.eyebrow}</span>
      <h1 data-reveal style="--i:1">{t.community.headingLine1}<br /><span class="serif-italic">{t.community.headingLine2}</span></h1>
      <p class="lede" data-reveal style="--i:2">{t.community.lede}</p>
    </div>
    <div class="wrap">
      <div class="page-head__media" data-reveal style="--i:3">
        <Img name="community-ill" alt={t.community.title} sizes="(max-width: 900px) 100vw, 90vw" />
      </div>
    </div>
  </header>

  <section class="section">
    <div class="wrap split">
      <div class="split__body">
        <span class="eyebrow" data-reveal>{t.community.rhythmEyebrow}</span>
        <h2 class="h2" data-reveal style="--i:1">{t.community.rhythmTitle}</h2>
        <p data-reveal style="--i:2" class="muted">{t.community.rhythmBody}</p>
        <div class="schedule" style="margin-top:1.5rem">
          {schedule.map((s) => (
            <div class="schedule__row">
              <span class="schedule__time">{s.time}</span>
              <span class="schedule__label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
      <figure class="split__media" data-reveal style="--i:2">
        <Img name="feather" alt={t.community.rhythmTitle} sizes="(max-width: 980px) 100vw, 46vw" />
      </figure>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow" data-reveal>{t.community.gatheringsEyebrow}</span>
          <h2 class="h2" data-reveal style="--i:1">{t.community.gatheringsTitle}</h2>
        </div>
      </div>

      <div class="meetings">
        <article class="meeting" data-reveal>
          <div class="meeting__media media">
            <Img name="clouds" alt={t.community.retreatsTitle} sizes="(max-width: 900px) 100vw, 60vw" />
          </div>
          <div class="meeting__body">
            <span class="pillar__sub">{t.community.retreatsKicker}</span>
            <h3>{t.community.retreatsTitle}</h3>
            <p>{t.community.retreatsBody}</p>
            <ul class="pills">
              {retreat.content.map((c) => <li>{c}</li>)}
            </ul>
            <p class="small muted">{t.community.retreatsNote}</p>
          </div>
        </article>

        <article class="meeting" data-reveal>
          <div class="meeting__media media media--tile">
            <Img name="program-taichi" alt={t.community.taiChiTitle} sizes="(max-width: 900px) 100vw, 60vw" />
          </div>
          <div class="meeting__body">
            <span class="pillar__sub">{t.community.taiChiKicker}</span>
            <h3>{t.community.taiChiTitle}</h3>
            <p>{t.community.taiChiBody}</p>
            <a class="link-arrow" href={href("/contact/", lang)} style="margin-top:1rem">
              {t.community.taiChiCta}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
            </a>
          </div>
        </article>

        <article class="meeting" data-reveal>
          <div class="meeting__media media">
            <Img name="temple" alt={t.community.hospiceTitle} sizes="(max-width: 900px) 100vw, 60vw" />
          </div>
          <div class="meeting__body">
            <span class="pillar__sub">{t.community.hospiceKicker}</span>
            <h3>{t.community.hospiceTitle}</h3>
            <p>{t.community.hospiceBody}</p>
            <a class="link-arrow" href={href("/programs/hospice-care/", lang)} style="margin-top:1rem">
              {t.community.hospiceCta}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow" data-reveal>{t.community.voicesEyebrow}</span>
          <h2 class="h2" data-reveal style="--i:1">{t.community.voicesTitle}</h2>
        </div>
        <a class="link-arrow" href={href("/about/", lang)} data-reveal>{t.community.voicesLink}</a>
      </div>
    </div>
    <div class="wrap" style="margin-top:2.5rem">
      <div class="rail">
        {testimonials.map((x, i) => (
          <article class="tcard" data-reveal style={`--i:${i}`}>
            <div>
              <h3>{x.title}</h3>
              <p style="margin-top:1rem">{x.quote}</p>
            </div>
            <div class="tcard__who">
              <img class="tcard__avatar" src={`${base}/media/${x.avatar}-75.webp`} alt="" width="37" height="37" loading="lazy" />
              <strong>{x.name}</strong>
              <span>{x.role}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap cta-row">
      <div>
        <span class="eyebrow">{t.community.pastEyebrow}</span>
        <h2 class="h2" style="margin-top:0.6rem">{t.community.pastTitle}</h2>
      </div>
      <div>
        <p style="color:rgba(236,230,216,.72);max-width:40ch">{t.community.pastBody}</p>
        <div class="hero__actions" style="margin-top:1.6rem">
          <a class="btn" href="https://youtube.com/playlist?list=PLp-bkW_-IYjNlppT0ucOQAd-ISRkoK9qN" target="_blank" rel="noopener">{t.community.pastWatch}</a>
          <a class="btn btn--ghost" href={href("/contact/", lang)}>{t.community.pastAsk}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .section-head .h2 { margin-top: 0.5rem; }

  .meetings { display: grid; gap: clamp(2.5rem, 6vw, 5rem); margin-top: clamp(2.5rem, 5vw, 4rem); }

  .meeting {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }

  .meeting:nth-child(even) .meeting__media { order: 2; }
  .meeting__media { aspect-ratio: 4/3; }
  .meeting__body { display: grid; gap: 0.9rem; align-content: center; }
  .meeting__body h3 { font-size: var(--step-3); font-weight: 300; }
  .meeting__body p { color: var(--muted); margin: 0; max-width: 46ch; }

  .pills { list-style: none; padding: 0; margin: 0.8rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pills li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35em 0.85em;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .cta-row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }

  @media (max-width: 860px) {
    .meeting { grid-template-columns: 1fr; }
    .meeting:nth-child(even) .meeting__media { order: 0; }
    .cta-row { grid-template-columns: 1fr; }
  }
</style>
