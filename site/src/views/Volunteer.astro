---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import { getContent, contact, type Lang } from "../i18n";
import { href } from "../lib/url";

interface Props { lang?: Lang }
const lang: Lang = Astro.props.lang ?? "en";
const { t, volunteerRoles } = getContent(lang);
---

<Base lang={lang} title={`${t.volunteer.title} — ${t.site.name}`} description={t.volunteer.lede}>
  <header class="page-head">
    <div class="wrap">
      <span class="eyebrow" data-reveal>{t.volunteer.eyebrow}</span>
      <h1 data-reveal style="--i:1">{t.volunteer.headingLine1}<br /><span class="serif-italic">{t.volunteer.headingLine2}</span></h1>
      <p class="lede" data-reveal style="--i:2">{t.volunteer.lede}</p>
    </div>
  </header>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="roles">
        {volunteerRoles.map((r, i) => (
          <article class="role" data-reveal style={`--i:${i}`}>
            <div class="role__media media">
              <Img name={r.image} alt={r.title} sizes="(max-width: 800px) 100vw, 30vw" />
            </div>
            <div class="role__head">
              <span class="role__no">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h2>{r.title}</h2>
                <span class="role__meta">{r.meta}</span>
              </div>
            </div>
            <p>{r.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--jade">
    <div class="wrap split">
      <div class="split__body">
        <span class="eyebrow" data-reveal>{t.volunteer.joinEyebrow}</span>
        <h2 class="h2" data-reveal style="--i:1">{t.volunteer.joinTitle}</h2>
        <p data-reveal style="--i:2;color:rgba(239,233,220,.75)">{t.volunteer.joinBody}</p>
        <div class="hero__actions" style="margin-top:1.8rem" data-reveal>
          <a class="btn" href={contact.volunteerForm} target="_blank" rel="noopener">{t.volunteer.joinCta}</a>
          <a class="btn btn--ghost" href={href("/contact/", lang)}>{t.volunteer.joinAsk}</a>
        </div>
      </div>
      <figure class="split__media media" data-reveal style="--i:2;aspect-ratio:4/5">
        <Img name="lilac" alt={t.volunteer.title} sizes="(max-width: 980px) 100vw, 46vw" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="quote" data-reveal style="text-align:center;justify-items:center">
        <blockquote style="max-width:20ch">{t.volunteer.quote}</blockquote>
        <p class="caption">{t.volunteer.quoteSource}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .roles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .role {
    padding: clamp(1.5rem, 3vw, 2.6rem) clamp(1.5rem, 3vw, 2.6rem) clamp(1.5rem, 3vw, 2.6rem) 0;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 1rem;
    align-content: start;
    transition: background 0.5s var(--ease);
  }

  .role:nth-child(odd) { border-right: 1px solid var(--line); }
  .role:nth-child(even) { padding-left: clamp(1.5rem, 3vw, 2.6rem); }
  .role:hover { background: var(--cream); }

  .role__media { aspect-ratio: 16/10; margin-bottom: 0.4rem; }

  .role__head { display: flex; gap: 1.2rem; align-items: baseline; }

  .role__no { font-size: 0.66rem; letter-spacing: 0.18em; color: var(--saffron); }

  .role h2 { font-size: var(--step-3); font-weight: 300; line-height: 1; }

  .role__meta {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .role p { color: var(--muted); margin: 0; max-width: 48ch; }

  @media (max-width: 800px) {
    .roles { grid-template-columns: 1fr; }
    .role:nth-child(odd) { border-right: 0; }
    .role, .role:nth-child(even) { padding-inline: 0; }
  }
</style>
