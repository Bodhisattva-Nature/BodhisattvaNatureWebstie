---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import { activities } from "../data/activities";
import { href } from "../lib/url";

const contactHref = href("/contact/", "zh");
const eventsHref = href("/events/", "zh");
const galleryPages = [];
for (let i = 0; i < activities.gallery.length; i += 3) {
  galleryPages.push(activities.gallery.slice(i, i + 3));
}
---

<Base
  lang="zh"
  zhOnly
  title={`${activities.title} — 菩萨本性基金会`}
  description={activities.lede}
>
  <header class="page-head activities-head">
    <div class="wrap">
      <span class="eyebrow" data-reveal>{activities.eyebrow}</span>
      <h1 data-reveal style="--i:1">{activities.title}</h1>
      <p class="lede" data-reveal style="--i:2">{activities.lede}</p>
      <ul class="activities-facts" data-reveal style="--i:3">
        {activities.facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </div>
  </header>

  <section class="section section--tight-top activities-atlas">
    <div class="wrap activity-explorer" data-explorer>
      <div class="explorer-menu">
        <span class="eyebrow atlas-eyebrow" data-reveal>{activities.explorerEyebrow}</span>
        <h2 class="h2 atlas-title" data-reveal style="--i:1;margin-top:.55rem">{activities.explorerTitle}</h2>

        <ul class="region-list" data-reveal style="--i:2">
          {activities.regions.map((region, i) => (
            <li class="region-item" data-region>
              <button
                type="button"
                class="region-btn"
                aria-expanded="false"
                aria-controls={`centers-${i}`}
                data-region-btn
              >
                <span class="region-btn__index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="region-btn__name">{region.name}</span>
                <span class="region-btn__meta">
                  {region.centers.length}
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="m4 6 4 4 4-4" />
                  </svg>
                </span>
              </button>
              <ul class="center-list" id={`centers-${i}`} data-center-list hidden>
                {region.centers.map((center) => (
                  <li>
                    <button type="button" class="center-btn" data-center={center.name}>
                      <span>{center.name}</span>
                      <span aria-hidden="true">→</span>
                    </button>
                  </li>
                ))}
                <li class="region-page-row">
                  <a class="region-page-link" href={href(`/activities/${region.slug}/`, "zh")}>
                    查看{region.name}全部活动
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              </ul>
            </li>
          ))}
        </ul>
      </div>

      <div class="explorer-preview" data-preview>
        <div class="preview-collage" aria-hidden="true">
          <span class="collage-sun"></span>
          <span class="collage-sheet"></span>
        </div>

        <div class="poster-pair" data-poster-pair>
          {activities.latestPosters.map((poster, i) => (
            <figure class="poster-card" data-reveal style={`--i:${i}`}>
              <div class="poster-card__media">
                <button
                  type="button"
                  class="poster-open"
                  data-lightbox-trigger
                  data-caption={poster.caption}
                  aria-label={`查看${poster.caption}大图`}
                >
                  <Img
                    name={poster.image}
                    alt={poster.alt}
                    sizes="(max-width: 900px) 46vw, 30vw"
                    loading="eager"
                  />
                </button>
              </div>
              <figcaption>{poster.caption}</figcaption>
            </figure>
          ))}
        </div>

        <figure class="poster-single" data-poster-single hidden>
          <div class="poster-single__media">
            <button
              type="button"
              class="poster-open"
              data-lightbox-trigger
              data-caption={activities.centerPoster.caption}
              aria-label={`查看${activities.centerPoster.caption}大图`}
            >
              <Img
                name={activities.centerPoster.image}
                alt={activities.centerPoster.alt}
                sizes="(max-width: 900px) 100vw, 48vw"
              />
            </button>
          </div>
          <figcaption>
            <span>{activities.centerPoster.caption}</span>
            <small data-center-caption>{activities.defaultCenterNote}</small>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section activities-types">
    <span class="types-tear types-tear--top" aria-hidden="true"></span>
    <span class="types-tear types-tear--bottom" aria-hidden="true"></span>
    <div class="wrap">
      <div class="section-head types-head">
        <div>
          <span class="eyebrow types-eyebrow" data-reveal>{activities.typesEyebrow}</span>
          <h2 class="h2" data-reveal style="--i:1">{activities.typesTitle}</h2>
        </div>
      </div>

      <div class="type-grid">
        {activities.types.map((group, i) => (
          <article class="type-card" data-reveal style={`--i:${i}`}>
            <span class="type-card__index">0{i + 1}</span>
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li class="type-item" tabindex="0">
                  <span>{item.name}</span>
                  <span class="type-item__pop" role="tooltip">{item.description}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow" data-reveal>{activities.galleryEyebrow}</span>
          <h2 class="h2" data-reveal style="--i:1">{activities.galleryTitle}</h2>
        </div>
        <p class="small muted gallery-note" data-reveal style="--i:2">{activities.galleryNote}</p>
      </div>

      <div class="gallery-carousel" data-carousel data-reveal>
        <div class="gallery-viewport">
          <div class="gallery-track" data-track aria-roledescription="carousel" aria-label="历次活动图片">
            {[galleryPages[galleryPages.length - 1], ...galleryPages, galleryPages[0]].map((page, pageIndex) => (
              <div class="gallery-page" aria-hidden={pageIndex === 0 || pageIndex === galleryPages.length + 1 ? "true" : undefined}>
                {page.map((item, i) => (
                  <figure class="gallery-card">
                    <div class="gallery-card__media">
                      <Img
                        name={item.image}
                        alt={item.alt}
                        sizes="(max-width: 700px) 33vw, 33vw"
                        loading="eager"
                      />
                    </div>
                    <figcaption>{item.caption}</figcaption>
                  </figure>
                ))}
              </div>
            ))}
          </div>
        </div>
        <div class="gallery-dots" role="group" aria-label="选择活动图片">
          {galleryPages.map((_, i) => (
            <button
              type="button"
              class="gallery-dot"
              aria-label={`第 ${i + 1} 组`}
              aria-current={i === 0 ? "true" : "false"}
              data-dot
            ></button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap">
      <div class="videos-head">
        <div>
          <span class="eyebrow" data-reveal>{activities.videosEyebrow}</span>
          <h2 class="h2" data-reveal style="--i:1">{activities.videosTitle}</h2>
        </div>
        <p class="small muted" data-reveal style="--i:2">{activities.videosNote}</p>
      </div>

      <div class="video-embeds">
        {activities.videos.map((video, i) => (
          <figure class="video-embed" data-reveal style={`--i:${i}`}>
            <div class="video-embed__frame">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0`}
                title={video.label}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
            <figcaption>{video.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink activities-online">
    <div class="wrap">
      <div class="online-head">
        <div>
          <span class="eyebrow" data-reveal>{activities.onlineEyebrow}</span>
          <h2 class="h2" data-reveal style="--i:1">{activities.onlineTitle}</h2>
        </div>
        <div>
          <p class="online-lede" data-reveal style="--i:2">{activities.onlineBody}</p>
          <a class="btn" href={contactHref} data-reveal style="--i:3">{activities.onlineCta}</a>
        </div>
      </div>

      <div class="schedule-grid">
        {activities.schedules.map((schedule, i) => (
          <figure class="schedule" data-reveal style={`--i:${i}`}>
            <figcaption>{schedule.label}</figcaption>
            <div class="schedule__media">
              <Img
                name={schedule.image}
                alt={schedule.label}
                sizes="(max-width: 700px) 100vw, 46vw"
                loading="lazy"
              />
            </div>
          </figure>
        ))}
      </div>
      <span class="online-word" aria-hidden="true">Zoom</span>
    </div>
  </section>

  <div class="poster-lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="活动海报" hidden>
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="关闭大图">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m3.5 3.5 9 9m0-9-9 9" />
      </svg>
    </button>
    <figure class="lightbox-figure">
      <img data-lightbox-image alt="" />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
  </div>

  <script>
    // Region explorer: continents first, centres on hover/click, poster on centre hover.
    const explorer = document.querySelector<HTMLElement>("[data-explorer]");
    if (explorer) {
      const regions = Array.from(explorer.querySelectorAll<HTMLElement>("[data-region]"));
      const pair = explorer.querySelector<HTMLElement>("[data-poster-pair]");
      const single = explorer.querySelector<HTMLElement>("[data-poster-single]");
      const centerCaption = explorer.querySelector<HTMLElement>("[data-center-caption]");
      const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

      const closeAll = () => {
        for (const region of regions) {
          region.querySelector<HTMLButtonElement>("[data-region-btn]")?.setAttribute("aria-expanded", "false");
          const list = region.querySelector<HTMLElement>("[data-center-list]");
          if (list) list.hidden = true;
        }
      };
      const showPair = () => {
        if (pair) pair.hidden = false;
        if (single) single.hidden = true;
      };
      const openRegion = (region: HTMLElement) => {
        closeAll();
        region.querySelector<HTMLButtonElement>("[data-region-btn]")?.setAttribute("aria-expanded", "true");
        const list = region.querySelector<HTMLElement>("[data-center-list]");
        if (list) list.hidden = false;
        showPair();
      };
      const showCenter = (name: string) => {
        if (pair) pair.hidden = true;
        if (single) single.hidden = false;
        if (centerCaption) centerCaption.textContent = `${name} · ${activitiesCaption()}`;
      };
      const activitiesCaption = () => "最新活动";
      const reset = () => {
        closeAll();
        showPair();
        if (centerCaption) centerCaption.textContent = "各地最新活动";
      };

      for (const region of regions) {
        const regionBtn = region.querySelector<HTMLButtonElement>("[data-region-btn]");
        const centerBtns = Array.from(region.querySelectorAll<HTMLButtonElement>("[data-center]"));
        if (!regionBtn) continue;
        if (canHover) regionBtn.addEventListener("mouseenter", () => openRegion(region));
        regionBtn.addEventListener("click", () => {
          const isOpen = regionBtn.getAttribute("aria-expanded") === "true";
          if (isOpen) reset();
          else openRegion(region);
        });
        for (const centerBtn of centerBtns) {
          const name = centerBtn.dataset.center ?? "";
          if (canHover) centerBtn.addEventListener("mouseenter", () => showCenter(name));
          centerBtn.addEventListener("click", () => showCenter(name));
        }
      }

      explorer.addEventListener("mouseleave", () => {
        if (canHover) reset();
      });
      document.addEventListener("click", (event) => {
        if (!explorer.contains(event.target as Node)) reset();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") reset();
      });
    }

    // Poster lightbox.
    const lightbox = document.querySelector<HTMLElement>("[data-lightbox]");
    if (lightbox) {
      const lightboxImage = lightbox.querySelector<HTMLImageElement>("[data-lightbox-image]");
      const lightboxCaption = lightbox.querySelector<HTMLElement>("[data-lightbox-caption]");
      const closeButton = lightbox.querySelector<HTMLButtonElement>("[data-lightbox-close]");
      let lastFocus: HTMLElement | null = null;
      let closeTimer: number | undefined;

      const closeLightbox = () => {
        if (lightbox.hidden) return;
        lightbox.classList.remove("is-open");
        document.body.style.overflow = "";
        document.documentElement.style.overflow = "";
        closeTimer = window.setTimeout(() => {
          lightbox.hidden = true;
        }, 220);
        lastFocus?.focus();
      };

      const openLightbox = (trigger: HTMLElement) => {
        const source = trigger.querySelector<HTMLImageElement>("img");
        if (!source || !lightboxImage) return;
        if (closeTimer) window.clearTimeout(closeTimer);
        lightboxImage.removeAttribute("srcset");
        lightboxImage.removeAttribute("sizes");
        lightboxImage.src = source.src;
        lightboxImage.alt = source.alt;
        if (lightboxCaption) lightboxCaption.textContent = trigger.dataset.caption || source.alt;
        lastFocus = trigger;
        lightbox.hidden = false;
        document.body.style.overflow = "hidden";
        document.documentElement.style.overflow = "hidden";
        window.requestAnimationFrame(() => lightbox.classList.add("is-open"));
        closeButton?.focus();
      };

      document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]").forEach((trigger) => {
        trigger.addEventListener("click", () => openLightbox(trigger));
      });

      closeButton?.addEventListener("click", closeLightbox);

      lightbox.addEventListener("click", (event) => {
        const target = event.target as Element;
        if (target.closest("img, button")) return;
        closeLightbox();
      });

      document.addEventListener("keydown", (event) => {
        if (lightbox.hidden) return;
        if (event.key === "Escape") {
          event.preventDefault();
          closeLightbox();
        } else if (event.key === "Tab") {
          event.preventDefault();
          closeButton?.focus();
        }
      });
    }

    // Infinite three-up gallery with dots and a seamless cloned first page.
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>("[data-track]");
      const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-dot]"));
      if (!track || dots.length === 0) return;

      const pageCount = dots.length;
      const firstPage = 1;
      const lastPage = pageCount;
      const cloneFirst = pageCount + 1;
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let current = firstPage;
      let timer: number | undefined;
      let wrapTimer: number | undefined;
      let jumping = false;

      const dotFor = (index: number) => ((index - firstPage) % pageCount + pageCount) % pageCount;

      const render = (index: number, animate = true) => {
        track.style.transition = animate && !reduced ? "transform 0.9s cubic-bezier(0.33, 1, 0.68, 1)" : "none";
        track.style.transform = `translate3d(-${index * 100}%, 0, 0)`;
        const active = dotFor(index);
        dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === active)));
      };

      const settleWrap = (target: number) => {
        if (!jumping) return;
        jumping = false;
        if (wrapTimer) window.clearTimeout(wrapTimer);
        wrapTimer = undefined;
        render(target, false);
        void track.offsetWidth;
        window.requestAnimationFrame(() => {
          track.style.transition = "";
          current = target;
        });
      };

      track.addEventListener("transitionend", (event) => {
        if (event.propertyName !== "transform" || !jumping) return;
        if (current === cloneFirst) settleWrap(firstPage);
        else if (current === 0) settleWrap(lastPage);
      });

      const next = () => {
        if (jumping) return;
        current += 1;
        render(current);
        if (current === cloneFirst) {
          jumping = true;
          wrapTimer = window.setTimeout(() => settleWrap(firstPage), 1100);
        }
      };

      const prev = () => {
        if (jumping) return;
        current -= 1;
        render(current);
        if (current === 0) {
          jumping = true;
          wrapTimer = window.setTimeout(() => settleWrap(lastPage), 1100);
        }
      };

      const stop = () => {
        if (timer) window.clearInterval(timer);
        timer = undefined;
      };
      const start = () => {
        stop();
        if (!reduced) timer = window.setInterval(next, 3500);
      };

      dots.forEach((dot, i) => dot.addEventListener("click", () => {
        if (jumping) return;
        current = i + firstPage;
        render(current);
        start();
      }));

      const viewport = carousel.querySelector<HTMLElement>(".gallery-viewport");
      let startX = 0;
      let startY = 0;
      let tracking = false;

      viewport?.addEventListener("touchstart", (event) => {
        if (event.touches.length !== 1) return;
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
        tracking = true;
        stop();
      }, { passive: true });

      viewport?.addEventListener("touchend", (event) => {
        if (!tracking) return;
        tracking = false;
        const touch = event.changedTouches[0];
        const dx = touch.clientX - startX;
        const dy = touch.clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) next();
          else prev();
        }
        start();
      }, { passive: true });

      carousel.addEventListener("mouseenter", stop);
      carousel.addEventListener("mouseleave", start);
      carousel.addEventListener("focusin", stop);
      carousel.addEventListener("focusout", (event) => {
        if (!carousel.contains(event.relatedTarget as Node)) start();
      });

      render(firstPage, false);
      start();
    });
  </script>
</Base>

<style>
  :global([hidden]) { display: none !important; }

  .activities-head { padding-bottom: clamp(1.5rem, 4vw, 3rem); }
  .activities-head h1 { max-width: 13ch; }
  .activities-head .lede { max-width: 58ch; }

  .activities-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }

  .activities-facts li {
    border: 1px solid rgba(164, 119, 31, 0.42);
    border-radius: 999px;
    padding: 0.42em 1em;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  /* ---------- 线下道场 / 总有一门: torn-paper collage ---------- */

  .activities-atlas,
  .activities-types {
    /* Sage, clay and oat paper, borrowed for these two sections only. */
    --sage: #3f5449;
    --sage-deep: #26362e;
    --sage-soft: #5b7164;
    --clay: #c0623c;
    --clay-deep: #9d4a29;

    /* Deckled edges. Percent-based so they hold at any card size. */
    --torn-card: polygon(0% -0.57%, 5.56% 0.91%, 11.11% 0.25%, 16.67% 0.94%, 22.22% -0.99%, 27.78% 0.78%, 33.33% -0.31%, 38.89% -0.98%, 44.44% -0.95%, 50% 1.06%, 55.56% 1.04%, 61.11% 0.07%, 66.67% -0.11%, 72.22% 0.11%, 77.78% 0.23%, 83.33% 0.61%, 88.89% 0.62%, 94.44% -0.18%, 99.74% 0%, 100.39% 12.5%, 99.85% 25%, 99.98% 37.5%, 99.55% 50%, 100.27% 62.5%, 100.37% 75%, 99.84% 87.5%, 94.44% 99.29%, 88.89% 101.06%, 83.33% 99.17%, 77.78% 99.9%, 72.22% 99.9%, 66.67% 99.14%, 61.11% 99.15%, 55.56% 100.27%, 50% 100.6%, 44.44% 99.09%, 38.89% 100.23%, 33.33% 100.94%, 27.78% 99.48%, 22.22% 100.2%, 16.67% 99.68%, 11.11% 99.59%, 5.56% 100.03%, 0.23% 87.5%, -0.21% 75%, -0.38% 62.5%, 0.41% 50%, 0.14% 37.5%, -0.13% 25%, 0.55% 12.5%);
    --torn-card-alt: polygon(0% -0.46%, 6.25% -0.24%, 12.5% 0.12%, 18.75% 0.03%, 25% 0.38%, 31.25% 0.57%, 37.5% -0.44%, 43.75% 0.38%, 50% -0.53%, 56.25% 0.73%, 62.5% -0.48%, 68.75% -0.02%, 75% -0.75%, 81.25% 0.5%, 87.5% -0.44%, 93.75% -0.48%, 99.9% 0%, 100.15% 14.29%, 99.78% 28.57%, 99.59% 42.86%, 99.93% 57.14%, 99.99% 71.43%, 100.28% 85.71%, 93.75% 100.71%, 87.5% 100.38%, 81.25% 99.87%, 75% 100.48%, 68.75% 99.56%, 62.5% 99.24%, 56.25% 99.7%, 50% 100.64%, 43.75% 100.16%, 37.5% 100.05%, 31.25% 99.68%, 25% 99.34%, 18.75% 100.63%, 12.5% 99.66%, 6.25% 99.24%, 0.13% 85.71%, 0.39% 71.43%, -0.38% 57.14%, 0.04% 42.86%, -0.03% 28.57%, 0.11% 14.29%);
    --torn-strip: polygon(0% -6.95%, 4.55% 13.93%, 9.09% 10.99%, 13.64% -8.8%, 18.18% 5.86%, 22.73% -6.22%, 27.27% -13.55%, 31.82% -8.34%, 36.36% -3.78%, 40.91% 12.24%, 45.45% -2.81%, 50% 8.82%, 54.55% 4.62%, 59.09% 11.47%, 63.64% -3.69%, 68.18% 3.49%, 72.73% 13.64%, 77.27% 12.18%, 81.82% 3.53%, 86.36% -13.92%, 90.91% 10.06%, 95.45% 3.3%, 99.3% 0%, 99.5% 25%, 100.52% 50%, 99.81% 75%, 95.45% 101.57%, 90.91% 87.74%, 86.36% 104.4%, 81.82% 98.41%, 77.27% 98.18%, 72.73% 96.7%, 68.18% 110.27%, 63.64% 92.69%, 59.09% 93.94%, 54.55% 98.82%, 50% 106.41%, 45.45% 110.48%, 40.91% 108.76%, 36.36% 102.02%, 31.82% 93.22%, 27.27% 101.68%, 22.73% 101.07%, 18.18% 103.78%, 13.64% 109.62%, 9.09% 89.58%, 4.55% 96.41%, 0.56% 75%, 0.01% 50%, -0.74% 25%);
  }

  .activities-atlas { overflow: clip; }

  .atlas-eyebrow,
  .types-eyebrow { color: var(--sage); }
  .atlas-eyebrow::before,
  .types-eyebrow::before { background: var(--clay); opacity: 1; }

  .atlas-title { position: relative; }
  .atlas-title::after {
    content: "";
    display: block;
    width: 3.6rem;
    height: 3px;
    margin-top: 1.15rem;
    background: linear-gradient(90deg, var(--clay), var(--clay-deep));
    clip-path: var(--torn-strip);
  }

  .activity-explorer {
    display: grid;
    grid-template-columns: minmax(260px, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }



  .region-list {
