---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import { getContent, type Lang } from "../i18n";
import { happinessSeries } from "../data/events";
import { href } from "../lib/url";

interface Props { lang?: Lang; program: any }
const lang: Lang = Astro.props.lang ?? "en";
const { program } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { t, isZh, programs, books } = getContent(lang);
const others = programs.filter((p) => p.slug !== program.slug).slice(0, 3);
---

<Base lang={lang} title={`${program.title} — ${t.site.name}`} description={program.summary} image={program.image}>
  <header class="prog-head">
    <div class="wrap prog-head__inner">
      <div>
        <span class="eyebrow" data-reveal>{program.kicker} · {program.no}</span>
        <h1 data-reveal style="--i:1">{program.title}</h1>
        <p class="lede" data-reveal style="--i:2">{program.summary}</p>
      </div>
      <div class="prog-head__media media" data-reveal style="--i:2">
        <Img name={program.hero} alt={program.title} sizes="(max-width: 900px) 100vw, 42vw" loading="eager" />
      </div>
    </div>
  </header>

  <section class="section" style="padding-top:clamp(2.5rem,5vw,4rem)">
    <div class="wrap split">
      <div class="split__body">
        <span class="eyebrow" data-reveal>{t.about.eyebrow}</span>
        {program.intro.map((p: string, i: number) => (
          <p class="lede" data-reveal style={`--i:${i}`}>{p}</p>
        ))}
        {program.links && (
          <div class="link-list" data-reveal style="--i:3">
            {program.links.map((l: any) => (
              <a href={l.href} target="_blank" rel="noopener" class="link-row">
                <span>{l.label}</span>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3">
                  <path d="M4 12 12 4M6 4h6v6" />
                </svg>
              </a>
            ))}
          </div>
        )}
      </div>
      <aside class="side-note" data-reveal style="--i:2">
        <p class="caption">{t.programDetail.glance}</p>
        <dl>
          <div><dt>{t.programDetail.format}</dt><dd>{t.programDetail.formatValue}</dd></div>
          <div><dt>{t.programDetail.cost}</dt><dd>{t.programDetail.costValue}</dd></div>
          <div><dt>{t.programDetail.where}</dt><dd>{t.programDetail.whereValue}</dd></div>
        </dl>
        <a class="btn" href={href("/contact/", lang)} style="margin-top:1.5rem">{program.cta}</a>
      </aside>
    </div>
  </section>

  {program.truths && (
    <section class="section section--cream">
      <div class="wrap">
        <span class="eyebrow" data-reveal>{t.programDetail.truthsEyebrow}</span>
        <div class="truths">
          {program.truths.map((x: any, i: number) => (
            <article class="truth" data-reveal style={`--i:${i}`}>
              <span class="truth__no">0{i + 1}</span>
              <h3>{x.title}</h3>
              <p>{x.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {program.gallery && (
    <section class="section section--cream">
      <div class="wrap">
        <div class="gallery">
          {program.gallery.map((g: any, i: number) => (
            <figure class="gallery__item" data-reveal style={`--i:${i}`}>
              <div class="media" style={`aspect-ratio:${g.ratio ?? "4/3"}`}>
                <Img name={g.image} alt={g.caption} sizes="(max-width: 800px) 100vw, 46vw" />
              </div>
              <figcaption class="caption">{g.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {program.bookGrid && (
    <section class="section section--cream" id="books">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow" data-reveal>{t.programDetail.booksEyebrow}</span>
            <h2 class="h2" data-reveal style="--i:1">{t.programDetail.booksTitle}</h2>
          </div>
          <p class="small muted" data-reveal style="max-width:32ch">{t.programDetail.booksNote}</p>
        </div>
        <div class="books">
          {books.map((b, i) => (
            <figure class="book" data-reveal style={`--i:${i}`}>
              <div class="media" style="aspect-ratio:2/3">
                <Img name={b.image} alt={`${b.title} — ${b.lang}`} sizes="(max-width: 800px) 44vw, 22vw" />
              </div>
              <figcaption>
                <span class="book__lang">{b.lang}</span>
                <span class="book__title">{b.title}</span>
                {b.file && (
                  <a class="book__dl" href={`${base}/downloads/${b.file}`} download>
                    {t.programDetail.download} <span>PDF · {b.size}</span>
                  </a>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {program.slug === "happiness-and-freedom" && (
    <section class="section" id="series">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow" data-reveal>{t.programDetail.seriesEyebrow}</span>
            <h2 class="h2" data-reveal style="--i:1">{t.programDetail.seriesTitle}</h2>
          </div>
          <p class="small muted" data-reveal style="--i:2;max-width:34ch">
            {t.programDetail.seriesNote}{" "}
            <a href="#books" class="link-inline">{t.programDetail.seriesBooksLink}</a>
          </p>
        </div>
        <div class="series">
          {happinessSeries.map((id, i) => (
            <figure class="episode" data-reveal style={`--i:${i % 3}`}>
              <button class="episode__play" type="button" data-video={id} aria-label={`${t.programDetail.seriesPlay} ${i + 1}`}>
                <img src={`${base}/series/${String(i + 1).padStart(2, "0")}.jpg`} alt="" width="640" height="360" loading="lazy" />
                <span class="episode__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                </span>
              </button>
              <figcaption>
                <span class="episode__no">{String(i + 1).padStart(2, "0")}</span>
                {t.programDetail.seriesEpisode} {i + 1}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow" data-reveal>{t.programDetail.coversEyebrow}</span>
          <h2 class="h2" data-reveal style="--i:1">{t.programDetail.coversTitle}</h2>
        </div>
      </div>
      <div class="highlights">
        {program.highlights.map((x: any, i: number) => (
          <article class="highlight" data-reveal style={`--i:${i}`}>
            <h3>{x.title}</h3>
            <p>{x.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow" data-reveal>{t.programDetail.othersEyebrow}</span>
          <h2 class="h2" data-reveal style="--i:1">{t.programDetail.othersTitle}</h2>
        </div>
        <a class="link-arrow" href={href("/programs/", lang)} data-reveal>{t.programDetail.allPrograms}</a>
      </div>
      <div class="others">
        {others.map((p, i) => (
          <a class="other" href={href(`/programs/${p.slug}/`, lang)} data-reveal style={`--i:${i}`}>
            <div class="other__media media media--tile zoom">
              <Img name={p.image} alt={p.title} sizes="(max-width: 800px) 100vw, 30vw" />
            </div>
            <span class="other__no">{p.no}</span>
            <h3>{p.title}</h3>
            <span class="link-arrow">
              {t.programsIndex.explore}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".episode__play")) {
    btn.addEventListener("click", () => {
      const id = btn.dataset.video;
      if (!id) return;
      const frame = document.createElement("iframe");
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      frame.title = btn.getAttribute("aria-label") ?? "Video";
      frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      frame.allowFullscreen = true;
      frame.loading = "lazy";
      btn.replaceWith(frame);
    });
  }
</script>

<style>
  .prog-head {
    padding-top: calc(var(--header-h) + clamp(2.5rem, 6vw, 5rem));
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .prog-head__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }

  .prog-head h1 {
    font-size: clamp(2.4rem, 6.5vw, 5.2rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.038em;
    margin-block: 0.35em 0;
  }

  .prog-head .lede { margin-top: 1.4rem; }

  .prog-head__media { aspect-ratio: 5/4; }

  .link-list {
    display: grid;
    border-top: 1px solid var(--line);
    margin-top: 0.5rem;
  }

  .link-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
    transition: color 0.3s var(--ease), padding 0.4s var(--ease);
  }

  .link-row:hover { color: var(--saffron); padding-left: 0.4rem; }

  .side-note {
    align-self: start;
    border: 1px solid var(--line);
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--cream);
    display: grid;
    gap: 1rem;
    position: sticky;
    top: 110px;
  }

  .side-note dl { margin: 0; display: grid; gap: 0.9rem; }
  .side-note div { display: grid; gap: 0.15rem; }
  .side-note dt { font-size: 0.64rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .side-note dd { margin: 0; font-size: 0.95rem; }

  .truths {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin-top: 2.5rem;
  }

  .truth {
    border-top: 1px solid var(--line);
    padding-top: 1.3rem;
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .truth__no { font-size: 0.68rem; letter-spacing: 0.16em; color: var(--saffron); }
  .truth h3 { font-size: var(--step-2); font-weight: 300; }
  .truth p { color: var(--muted); margin: 0; font-size: 0.95rem; }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .section-head .h2 { margin-top: 0.5rem; }

  .highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .highlight {
    border-top: 1px solid var(--line);
    padding-top: 1.3rem;
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .highlight h3 { font-size: var(--step-1); font-family: var(--font-body); font-weight: 500; letter-spacing: -0.01em; }
  .highlight p { color: var(--muted); margin: 0; font-size: 0.94rem; }

  .others {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .other { display: grid; gap: 0.9rem; align-content: start; }
  .other__media { aspect-ratio: 4/3; }
  .other__no { font-size: 0.64rem; letter-spacing: 0.18em; color: rgba(236, 230, 216, 0.45); }
  .other h3 { font-size: var(--step-2); font-weight: 300; }
  .section--ink .link-arrow { border-color: rgba(236, 230, 216, 0.3); color: rgba(236, 230, 216, 0.85); }

  .gallery {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .gallery__item { margin: 0; display: grid; gap: 0.8rem; }
  .gallery__item:nth-child(2) { margin-top: clamp(2rem, 6vw, 5rem); }

  .link-inline { color: var(--maroon); text-decoration: none; border-bottom: 1px solid rgba(58,12,22,.3); }

  .series { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.2rem, 2.5vw, 2rem); margin-top: clamp(2rem, 4vw, 3rem); }
  .episode { display: grid; gap: 0.6rem; }
  .episode__play {
    position: relative; padding: 0; border: 0; cursor: pointer; display: block;
    background: var(--cream); aspect-ratio: 16/9; overflow: hidden;
  }
  .episode__play img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .episode__play:hover img { transform: scale(1.03); }
  .episode__icon {
    position: absolute; inset: 0; display: grid; place-items: center;
    color: var(--cream); background: rgba(27, 20, 16, 0.18); transition: background 0.3s var(--ease);
  }
  .episode__icon svg { width: 46px; height: 46px; filter: drop-shadow(0 2px 8px rgba(0,0,0,.45)); }
  .episode__play:hover .episode__icon { background: rgba(27, 20, 16, 0.32); }
  .episode iframe { width: 100%; aspect-ratio: 16/9; border: 0; }
  .episode figcaption { font-size: 0.82rem; color: var(--muted); }
  .episode__no { color: var(--saffron); letter-spacing: 0.14em; margin-right: 0.5rem; font-size: 0.7rem; }
  @media (max-width: 860px) { .series { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .series { grid-template-columns: 1fr; } }

  .books {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .book { margin: 0; display: grid; gap: 0.9rem; }
  .book .media { box-shadow: var(--shadow-soft); }
  .book figcaption { display: grid; gap: 0.25rem; }
  .book__lang { font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--saffron); }
  .book__dl {
    margin-top: 0.5rem;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: baseline;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--maroon);
    text-decoration: none;
    border-bottom: 1px solid rgba(58, 12, 22, 0.3);
    padding-bottom: 2px;
  }
  .book__dl:hover { border-color: var(--maroon); }
  .book__dl span { color: var(--muted); letter-spacing: 0.04em; text-transform: none; font-size: 0.72rem; }

  .book__title { font-family: var(--font-display); font-size: 1rem; line-height: 1.2; }

  @media (max-width: 900px) {
    .link-inline { color: var(--maroon); text-decoration: none; border-bottom: 1px solid rgba(58,12,22,.3); }

  .series { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.2rem, 2.5vw, 2rem); margin-top: clamp(2rem, 4vw, 3rem); }
  .episode { display: grid; gap: 0.6rem; }
  .episode__play {
    position: relative; padding: 0; border: 0; cursor: pointer; display: block;
    background: var(--cream); aspect-ratio: 16/9; overflow: hidden;
  }
  .episode__play img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .episode__play:hover img { transform: scale(1.03); }
  .episode__icon {
    position: absolute; inset: 0; display: grid; place-items: center;
    color: var(--cream); background: rgba(27, 20, 16, 0.18); transition: background 0.3s var(--ease);
  }
  .episode__icon svg { width: 46px; height: 46px; filter: drop-shadow(0 2px 8px rgba(0,0,0,.45)); }
  .episode__play:hover .episode__icon { background: rgba(27, 20, 16, 0.32); }
  .episode iframe { width: 100%; aspect-ratio: 16/9; border: 0; }
  .episode figcaption { font-size: 0.82rem; color: var(--muted); }
  .episode__no { color: var(--saffron); letter-spacing: 0.14em; margin-right: 0.5rem; font-size: 0.7rem; }
  @media (max-width: 860px) { .series { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .series { grid-template-columns: 1fr; } }

  .books { grid-template-columns: repeat(2, 1fr); }
    .gallery { grid-template-columns: 1fr; }
    .gallery__item:nth-child(2) { margin-top: 0; }
    .prog-head__inner { grid-template-columns: 1fr; }
    .prog-head__media { aspect-ratio: 16/10; }
    .truths, .highlights, .others { grid-template-columns: 1fr; }
    .side-note { position: static; }
  }
</style>
