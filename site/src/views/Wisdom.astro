---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import { getContent, type Lang } from "../i18n";
import { href } from "../lib/url";

interface Props { lang?: Lang }
const lang: Lang = Astro.props.lang ?? "en";
const { t, quotes, books, seasonEvents, isZh } = getContent(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const bodhiClass = seasonEvents.find((event) => event.slug === "bodhi-class");

const byLength = [...quotes].sort((a, b) => a.body.length - b.body.length);
const featured = byLength[2];
const rest = quotes.filter((q) => q !== featured);
---

<Base lang={lang} title={`${t.wisdom.title} — ${t.site.name}`} description={t.wisdom.lede}>
  <header class="page-head">
    <div class="wrap">
      <span class="eyebrow" data-reveal>{t.wisdom.eyebrow}</span>
      <h1 data-reveal style="--i:1">{t.wisdom.headingA}<br /><span class="serif-italic">{t.wisdom.headingB}</span></h1>
      <p class="lede" data-reveal style="--i:2">{t.wisdom.lede}</p>
    </div>
  </header>

  <section class="section" style="padding-top:clamp(1rem,3vw,2rem)">
    <div class="wrap">
      <figure class="feature" data-reveal>
        <div class="feature__media media">
          <Img name="peace" alt={t.wisdom.title} sizes="100vw" loading="eager" />
          <span class="feature__scrim"></span>
        </div>
        <figcaption class="feature__quote">
          <blockquote>{featured.body}</blockquote>
          <span class="caption">{featured.title}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="quote-grid">
        {rest.map((q, i) => (
          <article class="qcard" data-reveal style={`--i:${i % 3}`}>
            <span class="qcard__no">{String(i + 1).padStart(2, "0")}</span>
            <h2>{q.title}</h2>
            <p>{q.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {isZh && bodhiClass && (
    <section class="section section--cream" id="bodhi-class">
      <div class="wrap bodhi">
        <div>
          <span class="eyebrow" data-reveal>共修课程</span>
          <h2 class="h2" data-reveal style="--i:1">
            {bodhiClass.title}
            {bodhiClass.titleCn && <span class="bodhi__cn">· {bodhiClass.titleCn}</span>}
          </h2>
          <p class="lede" data-reveal style="--i:2;margin-top:1.2rem">{bodhiClass.body}</p>
        </div>
        <div class="bodhi__side" data-reveal style="--i:2">
          <p class="bodhi__date">{bodhiClass.date}</p>
          <p class="bodhi__place">{bodhiClass.place}</p>
          <a class="btn" href={href("/contact/", "zh")}>咨询报名</a>
        </div>
      </div>
    </section>
  )}

  <section class="section section--cream" id="downloads">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow" data-reveal>{t.wisdom.downloadsEyebrow}</span>
          <h2 class="h2" data-reveal style="--i:1">{t.wisdom.downloadsTitle}</h2>
          <p class="small muted" data-reveal style="--i:2;margin-top:0.8rem;max-width:44ch">{t.wisdom.downloadsNote}</p>
        </div>
      </div>
      <ul class="dl-list">
        {books.map((b) => (
          <li data-reveal>
            <div>
              <span class="dl-list__lang">{b.lang}</span>
              <span class="dl-list__title">{b.title}</span>
            </div>
            {b.file && (
              <a class="dl-list__link" href={`${base}/downloads/${b.file}`} download>
                {t.programDetail.download} <span>PDF · {b.size}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--jade">
    <div class="wrap cta-row">
      <div>
        <span class="eyebrow">{t.wisdom.ctaEyebrow}</span>
        <h2 class="h2" style="margin-top:0.6rem">{t.wisdom.ctaTitle}</h2>
      </div>
      <div>
        <p style="color:rgba(239,233,220,.75);max-width:42ch">{t.wisdom.ctaBody}</p>
        <div class="hero__actions" style="margin-top:1.6rem">
          <a class="btn" href={href("/programs/dharma-study/", lang)}>{t.wisdom.ctaStudy}</a>
          <a class="btn btn--ghost" href={href("/contact/", lang)}>{t.wisdom.ctaAsk}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .feature {
    position: relative;
    margin: 0;
    display: grid;
  }

  .feature__media {
    position: relative;
    aspect-ratio: 21 / 10;
    overflow: hidden;
    background: var(--paper-deep);
  }

  .feature__media img { width: 100%; height: 100%; object-fit: cover; }

  .feature__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10, 9, 7, 0.92) 0%, rgba(10, 9, 7, 0.6) 42%, rgba(10, 9, 7, 0.12) 100%),
      linear-gradient(to right, rgba(10, 9, 7, 0.5) 0%, rgba(10, 9, 7, 0) 62%);
  }

  .feature__quote {
    position: absolute;
    left: clamp(1.5rem, 5vw, 4rem);
    right: clamp(1.5rem, 5vw, 4rem);
    bottom: clamp(1.5rem, 4vw, 3rem);
    display: grid;
    gap: 1.2rem;
    max-width: 52ch;
    color: #fbf6ea;
  }

  .feature__quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.1vw, 1.85rem);
    line-height: 1.24;
    letter-spacing: -0.018em;
    font-weight: 300;
    text-wrap: pretty;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .feature__quote blockquote::before { content: "“"; color: var(--saffron-soft); }
  .feature__quote blockquote::after { content: "”"; color: var(--saffron-soft); }

  .feature__quote .caption { color: rgba(251, 246, 234, 0.62); }

  .quote-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .qcard {
    border-bottom: 1px solid var(--line);
    border-right: 1px solid var(--line);
    padding: clamp(1.4rem, 2.6vw, 2.2rem);
    display: grid;
    gap: 0.8rem;
    align-content: start;
    transition: background 0.5s var(--ease);
  }

  .qcard:nth-child(3n) { border-right: 0; }
  .qcard:hover { background: var(--cream); }

  .dl-list { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0; }
  .dl-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }
  .dl-list li:last-child { border-bottom: 1px solid var(--line); }
  .dl-list__lang { display: block; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--saffron); }
  .dl-list__title { font-family: var(--font-display); font-size: 1.05rem; }
  .dl-list__link { font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--maroon); text-decoration: none; border-bottom: 1px solid rgba(58,12,22,.3); padding-bottom: 2px; white-space: nowrap; }
  .dl-list__link span { color: var(--muted); letter-spacing: 0.04em; text-transform: none; }
  .dl-list__link:hover { border-color: var(--maroon); }

  .qcard__no {
    font-size: 0.64rem;
    letter-spacing: 0.18em;
    color: var(--muted);
  }

  .qcard h2 {
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .qcard p { color: var(--muted); margin: 0; font-size: 0.92rem; line-height: 1.6; }

  .bodhi {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .bodhi__cn {
    color: var(--muted);
    font-size: 0.55em;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .bodhi__side {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    padding-left: clamp(0rem, 3vw, 2.5rem);
    border-left: 1px solid var(--line);
  }

  .bodhi__date { margin: 0; font-family: var(--font-display); font-size: 1.25rem; }
  .bodhi__place { margin: 0 0 1rem; color: var(--muted); font-size: 0.88rem; }

  .cta-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  @media (max-width: 720px) {
    .feature__media { aspect-ratio: 4/3; }
    .feature__quote blockquote { font-size: 1.1rem; }
  }

  @media (max-width: 980px) {
    .quote-grid { grid-template-columns: repeat(2, 1fr); }
    .qcard:nth-child(3n) { border-right: 1px solid var(--line); }
    .qcard:nth-child(2n) { border-right: 0; }
    .cta-row { grid-template-columns: 1fr; }
    .bodhi { grid-template-columns: 1fr; }
    .bodhi__side { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; padding-top: 1.2rem; }
  }

  @media (max-width: 640px) {
    .quote-grid { grid-template-columns: 1fr; }
    .qcard { border-right: 0 !important; }
  }
</style>
