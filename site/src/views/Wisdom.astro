---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import { getContent, type Lang } from "../i18n";
import { href } from "../lib/url";

interface Props { lang?: Lang }
const lang: Lang = Astro.props.lang ?? "en";
const { t, quotes } = getContent(lang);

const byLength = [...quotes].sort((a, b) => a.body.length - b.body.length);
const featured = byLength[2];
const rest = quotes.filter((q) => q !== featured);
---

<Base lang={lang} title={`${t.wisdom.title} — ${t.site.name}`} description={t.wisdom.lede}>
  <header class="page-head">
    <div class="wrap">
      <span class="eyebrow" data-reveal>{t.wisdom.eyebrow}</span>
      <h1 data-reveal style="--i:1">{t.wisdom.headingA}<br /><span class="serif-italic">{t.wisdom.headingB}</span></h1>
      <p class="lede" data-reveal style="--i:2">{t.wisdom.lede}</p>
    </div>
  </header>

  <section class="section" style="padding-top:clamp(1rem,3vw,2rem)">
    <div class="wrap">
      <figure class="feature" data-reveal>
        <div class="feature__media media">
          <Img name="peace" alt={t.wisdom.title} sizes="100vw" loading="eager" />
          <span class="feature__scrim"></span>
        </div>
        <figcaption class="feature__quote">
          <blockquote>{featured.body}</blockquote>
          <span class="caption">{featured.title}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="quote-grid">
        {rest.map((q, i) => (
          <article class="qcard" data-reveal style={`--i:${i % 3}`}>
            <span class="qcard__no">{String(i + 1).padStart(2, "0")}</span>
            <h2>{q.title}</h2>
            <p>{q.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--jade">
    <div class="wrap cta-row">
      <div>
        <span class="eyebrow">{t.wisdom.ctaEyebrow}</span>
        <h2 class="h2" style="margin-top:0.6rem">{t.wisdom.ctaTitle}</h2>
      </div>
      <div>
        <p style="color:rgba(239,233,220,.75);max-width:42ch">{t.wisdom.ctaBody}</p>
        <div class="hero__actions" style="margin-top:1.6rem">
          <a class="btn" href={href("/programs/dharma-study/", lang)}>{t.wisdom.ctaStudy}</a>
          <a class="btn btn--ghost" href={href("/contact/", lang)}>{t.wisdom.ctaAsk}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .feature {
    position: relative;
    margin: 0;
    display: grid;
  }

  .feature__media {
    position: relative;
    aspect-ratio: 21 / 10;
    overflow: hidden;
    background: var(--paper-deep);
  }

  .feature__media img { width: 100%; height: 100%; object-fit: cover; }

  .feature__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10, 9, 7, 0.92) 0%, rgba(10, 9, 7, 0.6) 42%, rgba(10, 9, 7, 0.12) 100%),
      linear-gradient(to right, rgba(10, 9, 7, 0.5) 0%, rgba(10, 9, 7, 0) 62%);
  }

  .feature__quote {
    position: absolute;
    left: clamp(1.5rem, 5vw, 4rem);
    right: clamp(1.5rem, 5vw, 4rem);
    bottom: clamp(1.5rem, 4vw, 3rem);
    display: grid;
    gap: 1.2rem;
    max-width: 52ch;
    color: #fbf6ea;
  }

  .feature__quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.1vw, 1.85rem);
    line-height: 1.24;
    letter-spacing: -0.018em;
    font-weight: 300;
    text-wrap: pretty;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .feature__quote blockquote::before { content: "“"; color: var(--saffron-soft); }
  .feature__quote blockquote::after { content: "”"; color: var(--saffron-soft); }

  .feature__quote .caption { color: rgba(251, 246, 234, 0.62); }

  .quote-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .qcard {
    border-bottom: 1px solid var(--line);
    border-right: 1px solid var(--line);
    padding: clamp(1.4rem, 2.6vw, 2.2rem);
    display: grid;
    gap: 0.8rem;
    align-content: start;
    transition: background 0.5s var(--ease);
  }

  .qcard:nth-child(3n) { border-right: 0; }
  .qcard:hover { background: var(--cream); }

  .qcard__no {
    font-size: 0.64rem;
    letter-spacing: 0.18em;
    color: var(--muted);
  }

  .qcard h2 {
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .qcard p { color: var(--muted); margin: 0; font-size: 0.92rem; line-height: 1.6; }

  .cta-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  @media (max-width: 720px) {
    .feature__media { aspect-ratio: 4/3; }
    .feature__quote blockquote { font-size: 1.1rem; }
  }

  @media (max-width: 980px) {
    .quote-grid { grid-template-columns: repeat(2, 1fr); }
    .qcard:nth-child(3n) { border-right: 1px solid var(--line); }
    .qcard:nth-child(2n) { border-right: 0; }
    .cta-row { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .quote-grid { grid-template-columns: 1fr; }
    .qcard { border-right: 0 !important; }
  }
</style>
